# MongoDB Atlas connection string, OR mongodb://mongo:27017 when using the bundled docker-compose
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
MONGODB_DB=sevaboard

# Optional. If set, the app shows a passcode screen and all API calls require it.
# Leave empty to keep the board open (recommended only behind Coolify/Cloudflare Access).
BOARD_PASSWORD=

# Public base URL of the deployed app — needed to build the Microsoft OAuth redirect URI
# consistently. Must exactly match a Redirect URI registered on the Azure AD app.
# e.g. https://seva-board.up.railway.app or https://seva.hkmvizag.org
APP_BASE_URL=

# Email — Connect Gmail (personal sign-in, highest priority). Each admin signs into
# their own Google account and sends as themselves. Requires a Google Cloud OAuth Client.
# See README.md for the exact setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Google Workspace (fixed shared "no-reply" sender via Gmail SMTP with an app
# password). Used only if no personal Gmail account is connected above. Simplest option,
# no Google Cloud project needed. See README.md for the exact setup steps.
GMAIL_USER=noreply@harekrishnavizag.org
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Seva Board

# Email — Outlook "Connect" sign-in (primary, recommended). Uses the SAME Azure AD app
# registration as the app-only vars below; just needs a Web redirect URI added and
# Mail.Send + offline_access requested as delegated (not application) permissions.
# No env var needed here beyond MS_CLIENT_ID / MS_CLIENT_SECRET / MS_TENANT_ID below —
# once those are set, use the "Connect Outlook" button inside the app (Manage → Email
# account) to sign in as mukunda@hkmvizag.org. See README.md for full setup steps.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Email — Microsoft 365 app-only fallback. Only used if no account is connected via the
# sign-in flow above. Sends as one fixed mailbox with no interactive login, but needs a
# Global Admin to grant tenant-wide consent once. Reuses MS_TENANT_ID/MS_CLIENT_ID/
# MS_CLIENT_SECRET above — just add this one extra var to enable it.
MS_SENDER_EMAIL=mukunda@hkmvizag.org

# Email — Resend (last-resort fallback, used only if neither Microsoft option is set up).
RESEND_API_KEY=
EMAIL_FROM=Seva Board <seva@harekrishnavizag.org>

# Push notifications (installable app). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Then paste them here / into Railway's Variables. Without these, the app still works
# and installs fine — the notification toggle just reports "not set up".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@hkmvizag.org
